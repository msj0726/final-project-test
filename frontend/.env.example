# 프론트엔드에 포함되는 값은 사용자에게 노출됩니다. 비밀 키를 넣지 마세요.

# API 연결 방식
#   hybrid(기본): 백엔드에 구현된 경로(현재 /healthz)는 실제 서버로, 아직 없는 경로는 목업으로
#   real        : 모든 요청을 실제 서버로
#   mock        : 모든 요청을 목업으로 (백엔드 없이 실행)
VITE_API_MODE=hybrid

# Sentry 오류 수집(선택). DSN 이 없으면 꺼진다. 영상·전사문·토큰은 보내지 않도록 전송 전에 지운다.
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# dev 서버가 /api·/healthz 를 넘겨 줄 백엔드 주소 (기본 http://127.0.0.1:8000)
VITE_PROXY_TARGET=http://127.0.0.1:8000
